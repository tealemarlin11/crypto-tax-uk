# Copy this file to ".env" and fill it in. NEVER commit ".env".
# Use READ-ONLY keys only (no trading, no withdrawals).
KRAKEN_KEY=
KRAKEN_SECRET=
BINANCE_KEY=
BINANCE_SECRET=
# Earliest date to pull from
START_DATE=2020-01-01
# Optional: coins you no longer hold, in case Binance does not show them
BINANCE_EXTRA_ASSETS=
# Optional: extra Binance pairs to check, e.g. BTCGBP,ETHGBP
BINANCE_SYMBOLS=
